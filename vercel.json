{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/[...path].js": { "maxDuration": 60 },
    "api/gmail/[...action].js": { "maxDuration": 60 },
    "api/cron/gmail.js": { "maxDuration": 60 }
  },
  "redirects": [
    { "source": "/", "destination": "/fixed.html", "permanent": false }
  ],
  "crons": [
    {
      "path": "/api/cron/gmail",
      "schedule": "0 2 * * *"
    }
  ]
}
