PORT=3000
APP_BASE_URL=http://localhost:3000
APP_TIMEZONE=Asia/Kolkata

# Public Supabase settings. The hosted beta already has safe publishable fallbacks in server.js.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Server-side only. Add this in Vercel to activate Gmail, reminders, WhatsApp and billing.
SUPABASE_SECRET_KEY=

# OpenAI — server side only
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Google OAuth / Gmail API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback
TOKEN_ENCRYPTION_KEY=
OAUTH_STATE_SECRET=
GMAIL_SCAN_INTERVAL_MINUTES=15
ALLOW_FREE_AUTO_SCAN=false

# Stripe subscriptions
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Meta WhatsApp Business Cloud API webhook
META_WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=

# Vercel Cron authentication
CRON_SECRET=
